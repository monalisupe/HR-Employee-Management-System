# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# PostgreSQL Database Connection
# Option A: Full Connection URI (Supabase, Neon, Render, Railway, AWS RDS, or Local)
# For Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# Option B: Individual PostgreSQL parameters
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=postgres
# DB_SSL=false

# Supabase Auth & Storage API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret
JWT_SECRET=your-secret-key-change-in-production

